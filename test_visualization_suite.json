      "tags": ["frontend", "kolay", "css"],
      "difficulty": 2.0,
      "content": {
        "text": "HTML5 dosya yapısında ana içerik alanını temsil eden semantik etiket hangisidir?"
      },
      "options": [
        { "id": 1, "text": "`<main>`" },
        { "id": 2, "text": "`<section>`" },
        { "id": 3, "text": "`<div>`" },
        { "id": 4, "text": "`<content>`" }
      ],
      "answer": {
        "correct_ids": [1],
        "explanation": "`<main>` etiketi belgenin ana ve özgün içeriğini kapsar."
      }
    },
    {
      "id": "q02_kolay_2",
      "type": "true_false",
      "category": "Web Teknolojileri",
      "tags": ["javascript", "kolay"],
      "difficulty": 3.0,
      "content": {
        "text": "JavaScript `const` ile tanımlanan bir dizinin elemanları `push` metodu ile değiştirilebilir."
      },
      "options": [
        { "id": 1, "text": "Doğru" },
        { "id": 2, "text": "Yanlış" }
      ],
      "answer": {
        "correct_ids": [1],
        "explanation": "`const` değişkenin referansını sabitleştirir, içerisindeki nesne veya dizi mutation (değişim) işlemlerini engellemez."
      }
    },
    {
      "id": "q03_kolay_3",
      "type": "short_answer",
      "category": "Genel Kültür",
      "tags": ["bilim", "kolay"],
      "difficulty": 1.5,
      "content": {
        "text": "Dünya'nın doğal uydusunun adı nedir?"
      },
      "answer": {
        "accepted_texts": ["Ay", "Moon", "ay"],
        "explanation": "Dünya'nın tek doğal uydusu Ay'dır."
      }
    },
    {
      "id": "q04_orta_1",
      "type": "multiple_choice",
      "category": "Veri Yapıları",
      "tags": ["algoritma", "orta"],
      "difficulty": 5.5,
      "content": {
        "text": "Aşağıdaki veri yapılarından hangileri LIFO (Last-In-First-Out) prensibiyle çalışabilir?"
      },
      "options": [
        { "id": 1, "text": "Stack (Yığın)" },
        { "id": 2, "text": "Call Stack (Çağrı Yığını)" },
        { "id": 3, "text": "Queue (Kuyruk)" },
        { "id": 4, "text": "Linked List (Çift yönlü)" }
      ],
      "answer": {
        "correct_ids": [1, 2],
        "explanation": "Stack ve Call Stack son giren ilk çıkar (LIFO) yapısına sahiptir."
      }
    },
    {
      "id": "q05_orta_2",
      "type": "fill_in_the_blank",
      "category": "Web Teknolojileri",
      "tags": ["css", "orta"],
      "difficulty": 6.0,
      "content": {
        "text": "CSS Grid yerleşiminde sütunları esnek 2 eşit parçaya bölmek için `grid-template-columns: {{repeat(2, 1fr)}}` kullanılır."
      },
      "answer": {
        "explanation": "`1fr` esnek kesirli birim anlamına gelir."
      }
    },
    {
      "id": "q06_orta_3",
      "type": "single_choice",
      "category": "Veri Yapıları",
      "tags": ["algoritma", "orta"],
      "difficulty": 5.0,
      "content": {
        "text": "Dengeli bir İkili Arama Ağacında (Binary Search Tree) arama işleminin karmaşıklığı nedir?"
      },
      "options": [
        { "id": 1, "text": "O(1)" },
        { "id": 2, "text": "O(log n)" },
        { "id": 3, "text": "O(n)" },
        { "id": 4, "text": "O(n log n)" }
      ],
      "answer": {
        "correct_ids": [2],
        "explanation": "Dengeli ağaçlarda her adımda arama alanı ikiye bölündüğü için zaman karmaşıklığı O(log n)'dir."
      }
    },
    {
      "id": "q07_zor_1",
      "type": "single_choice",
      "category": "Yazılım Mimarisi",
      "tags": ["design-patterns", "zor"],
      "difficulty": 7.5,
      "content": {
        "text": "SOLID prensiplerindeki 'D' (Dependency Inversion) ilkesinin temel amacı nedir?"
      },
      "options": [
        { "id": 1, "text": "Üst seviye modüllerin alt seviye modüllere doğrudan bağımlı olmaması, ikisinin de soyutlamalara bağımlı olması" },
        { "id": 2, "text": "Bir sınıfın yalnızca tek bir sorumluluğa sahip olması" },
        { "id": 3, "text": "Kodun gelişime açık değişime kapalı olması" },
        { "id": 4, "text": "Tüm arayüzlerin tek bir geniş arayüzde toplanması" }
      ],
      "answer": {
        "correct_ids": [1],
        "explanation": "Bağımlılıkların tersine çevrilmesi ilkesi, somut sınıflar yerine soyutlamalara (interface/abstract) bağımlı olunmasını savunur."
      }
    },
    {
      "id": "q08_zor_2",
      "type": "multiple_choice",
      "category": "Ağ & Güvenlik",
      "tags": ["network", "zor"],
      "difficulty": 8.0,
      "content": {
        "text": "HTTPS protokolünde Handshake aşamasında gerçekleşen adımlar hangileridir?"
      },
      "options": [
        { "id": 1, "text": "Client Hello & Server Hello mesajlaşması" },
        { "id": 2, "text": "Sertifika doğrulaması ve açık anahtar değişimi" },
        { "id": 3, "text": "Simetrik şifreleme anahtarının (Session Key) türetilmesi" },
        { "id": 4, "text": "Verilerin düz metin (plaintext) olarak iletilmesi" }
      ],
      "answer": {
        "correct_ids": [1, 2, 3],
        "explanation": "HTTPS Handshake aşamasında istemci-sunucu selamlaşması, sertifika denetimi ve oturum anahtarı oluşturulması yapılır."
      }
    },
    {
      "id": "q09_cok_zor_1",
      "type": "flashcard",
      "category": "İşletim Sistemleri",
      "tags": ["os", "cok-zor"],
      "difficulty": 9.5,
      "content": {
        "text": "Deadlock (Kilitlenme) oluşması için gerekli 4 Coffman koşulu nelerdir?"
      },
      "answer": {
        "back": "1. Mutual Exclusion (Karşılıklı Dışlama)\n2. Hold and Wait (Tut ve Bekle)\n3. No Preemption (Kesintisizlik/Zorla Alamama)\n4. Circular Wait (Dairesel Bekleme)",
        "explanation": "Bu 4 koşul aynı anda gerçekleştiğinde sistemde kilitlenme (deadlock) meydana gelebilir."
      }
    },
    {
      "id": "q10_cok_zor_2",
      "type": "single_choice",
      "category": "Veri Tabanı",
      "tags": ["sql", "cok-zor"],
      "difficulty": 9.0,
      "content": {
        "text": "ACID prensiplerinde 'Isolation' seviyelerinden en katı olanı ve 'Phantom Read'i tamamen engelleyeni hangisidir?"
      },
      "options": [
        { "id": 1, "text": "Read Uncommitted" },
        { "id": 2, "text": "Read Committed" },
        { "id": 3, "text": "Repeatable Read" },
        { "id": 4, "text": "Serializable" }
      ],
      "answer": {
        "correct_ids": [4],
        "explanation": "Serializable en yüksek izolasyon seviyesidir; işlemleri sırayla çalıştırıyormuş gibi kilitler ve Phantom Read durumunu önler."
      }
    },
    {
      "id": "q11_cozulmedi_1",
      "type": "reading",
      "category": "Rehber",
      "tags": ["dokumantasyon", "cozulmedi"],
      "difficulty": 4.0,
      "content": {
        "text": "# Test Ortamı Dokümantasyonu\n\nBu kart henüz çözülmemiş veya henüz istatistik üretilmemiş ögeleri temsil eder."
      },
      "answer": {
        "explanation": "Okuma kartı test amacıyla eklenmiştir."
      }
    },
    {
      "id": "q12_cozulmedi_2",
      "type": "single_choice",
      "category": "Matematik",
      "tags": ["cozulmedi"],
      "difficulty": 6.5,
      "content": {
        "text": "Asal sayıların sonsuz olduğunu kanıtlayan antik Yunan matematikçi kimdir?"
      },
      "options": [
        { "id": 1, "text": "Öklid (Euclid)" },
        { "id": 2, "text": "Pisagor" },
        { "id": 3, "text": "Arşimet" },
        { "id": 4, "text": "Tales" }
      ],
      "answer": {
        "correct_ids": [1],
        "explanation": "Öklid, Elemanlar (Elements) adlı eserinde asal sayıların sonsuzluğunu kanıtlamıştır."
      }
    }
